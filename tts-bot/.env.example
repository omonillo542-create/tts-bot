# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini API Key (Google AI Studio) — AI Studio'dan olingan "AIza..." kaliti
# Eslatma: OAuth token (AQ....) ISHLAMAYDI, faqat API key ishlaydi.
MIYYA_API_KEY=your_gemini_api_key_here

# OpenRouter — LLM (suhbat, niyat, matn tahlili) uchun ikkinchi kalit
OPENROUTER_THINKING_KEY=your_openrouter_key_here

# OpenAI API Key — realistik AI ovozlari uchun (gpt-4o-mini-tts)
# Bo'lmasa bot avtomatik boshqa dvigatellarga o'tadi
OPENAI_API_KEY=

# --- Sozlamalar ---
# Admin ID lari (vergul bilan ajrating)
ADMIN_IDS=123456789,987654321

# Kunlik so'rovlar limiti (0 = cheklovsiz)
DAILY_LIMIT=50

# --- AI TTS (realistik ovozlar) ---
# Gemini 2.5 Flash TTS — AI Studio bepul tierida, o'zbek tilini qo'llab-quvvatlaydi
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_ENABLED=true
# OpenAI TTS
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Realistik AI ovozi Edge'dan oldin ishlatilsinmi?
AI_TTS_FIRST=true

# --- LLM zanjiri (OpenRouter -> Gemini -> kalit so'z) ---
# Ro'yxatdagi modellar ketma-ket sinanadi
LLM_MODELS=meta-llama/llama-3.3-70b-instruct,google/gemini-2.5-flash-lite,openai/gpt-4o-mini
THINKING_MODEL=meta-llama/llama-3.3-70b-instruct

# --- STT (ovoz -> matn) zaxirasi: lokal faster-whisper ---
# Gemini kaliti ishlamasa shu ishlatiladi
WHISPER_MODEL_SIZE=small

# --- Kokoro TTS (fallback) ---
KOKORO_API_URL=https://strive33-kokoro-tts-fastapi.hf.space/tts
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_ENABLED=true
# Sekin serverlar uchun kutish vaqti (soniya)
KOKORO_TIMEOUT=180

# --- Fish Audio TTS (OpenRouter) ---
# Modellar ro'yxati: birinchisi ishlamasa (timeout/429) keyingisiga o'tiladi
# Eslatma: "s2.1-pro-free" ning KUNLIK limiti tez tugaydi (429) — s2.1-pro birinchi
FISH_TTS_MODELS=fish-audio/s2.1-pro,fish-audio/s2.1-pro-free:free
# Bitta so'rovga umumiy vaqt (soniya) — "vaqt tugaydi" xatosining oldini oladi
FISH_TIMEOUT=300
# Serverga ulanish vaqti (soniya)
FISH_CONNECT_TIMEOUT=30
# 429 / 5xx / timeout uchun qayta urinishlar soni
FISH_RETRIES=2
# Umumiy vaqt byudjeti (soniya) — barcha urinishlar uchun
FISH_BUDGET=600
# Bitta so'rovdagi maksimal belgi. Kichikroq = kamroq timeout + yaxshiroq talaffuz
FISH_CHUNK_CHARS=900
# O'zbekcha matnni tayyorlash:
#   cyrillic — lotin -> kirill (Fish Audio uchun eng to'g'ri talaffuz) + raqamlar so'zga
#   latin    — faqat raqamlar so'zga, matn o'zgarishsiz
#   off      — hech narsa o'zgartirilmaydi
FISH_UZ_MODE=cyrillic
# Sifat/tezlik: low | normal | high  (high — sifatliroq, lekin sekin)
FISH_LATENCY=high
